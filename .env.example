# Plantilla de variables de entorno.
#
# Copia este archivo como .env y llena los valores. El .env no se sube al
# repositorio: cada quien tiene el suyo, y las contrasenas reales nunca quedan
# en el historial de git.
#
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (Linux o Mac)
#
# Los tres del equipo deben usar los mismos valores, o las instrucciones de
# arranque no funcionan igual en las tres maquinas.

# --- PostgreSQL ---
DB_USER=cambiame
DB_PASSWORD=cambiame
DB_NAME=mesh

# --- pgAdmin ---
PGADMIN_EMAIL=cambiame@mesh.com
PGADMIN_PASSWORD=cambiame

# --- MongoDB ---
# Usa los mismos valores que PostgreSQL si quieres una sola credencial
MONGO_USER=cambiame
MONGO_PASSWORD=cambiame
MONGO_DB=mesh

# --- Redis (Entrega 2: carrito y oferta limitada) ---
REDIS_PASSWORD=cambiame
# Los otros dos usuarios de Redis (control de acceso). arrancar.ps1 los llena
# solo con una contrasena al azar si faltan.
REDIS_INSPECCION_PASSWORD=cambiame
REDIS_OPERADOR_PASSWORD=cambiame

# --- Neo4j (Entrega 2: deteccion de fraude en resenas) ---
# El usuario es siempre "neo4j" en la edicion community, no se puede cambiar.
# La contrasena debe tener al menos 8 caracteres o Neo4j no arranca.
NEO4J_PASSWORD=cambiame

# --- ClickHouse (base columnar: eventos, tendencias y fraude) ---
# La base y el usuario se crean en el PRIMER arranque. Cambiar la contrasena
# aqui sobre un volumen que ya existe NO la cambia en la base: para eso hay que
# correr .\arrancar.ps1 -Reiniciar.
CLICKHOUSE_DB=mesh_eventos
CLICKHOUSE_USER=cambiame
CLICKHOUSE_PASSWORD=cambiame

# --- Usuarios por servicio (control de acceso, desde el 2026-10-23) ---
# Cada base tiene un usuario para el backend que solo puede lo que la tienda
# necesita, y otro de solo lectura para mirar. arrancar.ps1 llena SOLAS todas
# estas con una contrasena al azar si faltan, crea los usuarios en cada base y
# pone los del backend en backend\.env. No hace falta escribirlas a mano.
# Ver docs/SEGURIDAD.md.
PG_BACKEND_PASSWORD=cambiame
PG_LECTURA_PASSWORD=cambiame
MONGO_BACKEND_PASSWORD=cambiame
MONGO_LECTURA_PASSWORD=cambiame
REDIS_BACKEND_PASSWORD=cambiame
CLICKHOUSE_BACKEND_PASSWORD=cambiame
CLICKHOUSE_LECTURA_PASSWORD=cambiame

# --- Elasticsearch, con la seguridad encendida desde el 2026-10-23 ---
# elastic es el superusuario (arrancar, ETL, pruebas). kibana_system es con el
# que Kibana habla con Elasticsearch. mesh_backend el backend y mesh_lectura
# para entrar a Kibana a mirar. arrancar.ps1 tambien las llena solas.
ELASTIC_PASSWORD=cambiame
KIBANA_PASSWORD=cambiame
ELASTIC_BACKEND_PASSWORD=cambiame
ELASTIC_LECTURA_PASSWORD=cambiame
