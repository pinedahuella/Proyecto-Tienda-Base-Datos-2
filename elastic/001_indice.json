{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,

    "analysis": {
      "analyzer": {
        "espanol_llano": {
          "tokenizer": "standard",
          "filter": ["lowercase", "asciifolding"]
        }
      }
    }
  },

  "mappings": {
    "properties": {
      "nombre": {
        "type": "text",
        "analyzer": "espanol_llano",
        "fields": {
          "escribiendo": {
            "type": "search_as_you_type",
            "analyzer": "espanol_llano"
          },
          "exacto": {
            "type": "keyword",
            "ignore_above": 256
          }
        }
      },

      "descripcion": {
        "type": "text",
        "analyzer": "espanol_llano"
      },

      "categoria_nombre": {
        "type": "text",
        "analyzer": "espanol_llano",
        "fields": {
          "exacto": { "type": "keyword" }
        }
      },
      "categoria_padre": { "type": "keyword" },
      "id_categoria": { "type": "integer" },

      "estado": { "type": "keyword" },

      "precio_desde": { "type": "double" },
      "precio_tienda": { "type": "double" },
      "stock_total": { "type": "integer" },
      "total_ofertas": { "type": "integer" },
      "hay_descuento": { "type": "boolean" },

      "resenas_promedio": { "type": "double" },
      "resenas_total": { "type": "integer" },

      "variantes": {
        "type": "text",
        "analyzer": "espanol_llano"
      }
    }
  }
}
