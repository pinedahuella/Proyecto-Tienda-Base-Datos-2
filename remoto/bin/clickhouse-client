#!/usr/bin/env bash
# remoto/bin/clickhouse-client -- el clickhouse-client de "dentro de
# mesh-clickhouse", en el modo remoto: remoto/clientes/clickhouse-client.cjs por
# HTTP contra localhost:8123, que remoto/tunel.cjs lleva a la otra PC.
source "$(dirname "$0")/../comun.sh"
MSYS_NO_PATHCONV=1 exec node "$NODE_REMOTO/clickhouse-client.cjs" "$@"
