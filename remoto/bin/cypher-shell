#!/usr/bin/env bash
# remoto/bin/cypher-shell -- el cypher-shell de "dentro de mesh-neo4j", en el
# modo remoto: remoto/clientes/cypher-shell.cjs contra bolt://localhost:7687,
# que remoto/tunel.cjs lleva a la otra PC. Las rutas del contenedor (-f
# /neo4j/consultas/...) se traducen a las del repo.
source "$(dirname "$0")/../comun.sh"
traducir_args "$@"
MSYS_NO_PATHCONV=1 exec node "$NODE_REMOTO/cypher-shell.cjs" "${ARGS[@]}"
