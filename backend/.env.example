# Plantilla. Copiala como .env y llena los valores.
#
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (Linux o Mac)
#
# Deben coincidir con el .env de la raiz del proyecto, que es el que usa Docker
# para crear la base. Si no coinciden, el backend no conecta.

DB_HOST=localhost
DB_PORT=5432
DB_USER=cambiame
DB_PASSWORD=cambiame
DB_NAME=mesh

PORT=3000

# Secreto para firmar el token de sesion (JWT). No es una contrasena que se
# comparte con nadie mas: cada quien genera la suya. Con este comando sale
# una al azar:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiame
