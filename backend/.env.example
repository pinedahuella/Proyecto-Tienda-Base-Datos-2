# Plantilla. Copiala como .env y llena los valores.
#
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (Linux o Mac)
#
# Deben coincidir con el .env de la raiz del proyecto, que es el que usa Docker
# para crear la base. Si no coinciden, el backend no conecta.
#
# CADA BASE CON SU USUARIO. Desde el 2026-10-23 el backend no entra como el
# dueno de cada base sino como mesh_backend, que solo puede lo que la tienda
# necesita (docs/SEGURIDAD.md). arrancar.ps1 crea esos usuarios y, si las bases
# son de esta PC, escribe solo aqui los usuarios y contrasenas. No hace falta
# llenarlos a mano.

DB_HOST=localhost
DB_PORT=5432
DB_USER=mesh_backend
DB_PASSWORD=cambiame
DB_NAME=mesh

MONGO_HOST=localhost
MONGO_PORT=27018
MONGO_USER=mesh_backend
MONGO_PASSWORD=cambiame
MONGO_DB=mesh

# Redis (carrito y oferta limitada, Entrega 2). El usuario de ACL backend, que
# solo toca las claves mesh:*. Su contrasena es REDIS_BACKEND_PASSWORD del .env
# de la raiz.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=backend
REDIS_PASSWORD=cambiame

# Neo4j (deteccion de fraude en resenas, Entrega 2). El usuario es siempre
# "neo4j" en la edicion community, que no trae roles (docs/SEGURIDAD.md). Debe
# coincidir con NEO4J_PASSWORD del .env de la raiz.
NEO4J_HOST=localhost
NEO4J_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cambiame

# ClickHouse (eventos de producto y buscador, ver
# elementos Generales/plan pendiente/eventos-clickhouse.md). Se conecta por
# el puerto HTTP (8123), no el nativo. Debe coincidir con las variables
# CLICKHOUSE_* del .env de la raiz.
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=mesh_eventos
CLICKHOUSE_USER=mesh_backend
CLICKHOUSE_PASSWORD=cambiame

# Elasticsearch (el buscador, Entrega 3). Con la seguridad encendida desde el
# 2026-10-23, el backend entra como mesh_backend. Sin ELASTIC_USER va sin
# usuario, que sirve para un Elasticsearch que todavia no tiene seguridad.
ELASTIC_HOST=localhost
ELASTIC_PORT=9200
ELASTIC_USER=mesh_backend
ELASTIC_PASSWORD=cambiame
# Indice del buscador de catalogo (BuscadorSyncService).
ELASTIC_INDICE=mesh_productos
# Indice del log de autenticacion (EventosAutenticacionSyncService).
ELASTIC_INDICE_EVENTOS=mesh_eventos_autenticacion
# Indice del buscador de ofertas (EventoOfertaSyncService, GET /vendedor/ofertas/buscar).
ELASTIC_INDICE_OFERTAS=mesh_ofertas
# Percolator de los seguimientos del comprador (avisame cuando llegue / cuando baje).
ELASTIC_INDICE_SEGUIMIENTOS=mesh_seguimientos
# Pesos de la regresion logistica que valora el texto de las resenas (opcional;
# por defecto backend/modelos/regresion_logistica.json).
# CLASIFICADOR_MODELO=

# Ollama (recomendacion semantica, Entrega final). Debe coincidir con lo que
# haya quedado arriba tras correr arrancar.ps1 (el de la PC o mesh-ollama).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO_VECTORES=paraphrase-multilingual

PORT=3000

# Secreto para firmar el token de sesion (JWT). No es una contrasena que se
# comparte con nadie mas: cada quien genera la suya. Con este comando sale
# una al azar:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiame

# --- Correo del dashboard (exportar por correo). Sin SMTP_HOST la ruta avisa que falta.
# Con Gmail: smtp.gmail.com, 587, la cuenta y una contrasena de aplicacion.
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_CONTRASENA=cambiame
SMTP_REMITENTE=Mesh <cuenta@gmail.com>
