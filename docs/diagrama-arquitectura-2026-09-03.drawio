        </mxCell>

        <mxCell id="mongo" value="MongoDB 27018&#10;&#10;CATALOGO Y SU HISTORIAL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEF3E4;strokeColor=#2E8B57;fontColor=#1E5C3A;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="420" y="340" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="mongoDetalle" value="Colecciones: productos, productos_eventos,&#10;categorias.&#10;Atributos variables por categoria.&#10;Indices catalogo_categoria, catalogo_precio&#10;y catalogo_rating.&#10;Historial por eventos, reconstruible por fecha." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6FBF8;strokeColor=#A6D5B8;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="420" y="455" width="280" height="90" as="geometry" />
        </mxCell>

        <mxCell id="redis" value="Redis 6379&#10;&#10;LO TRANSITORIO Y LO ATOMICO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE9E7;strokeColor=#C0392B;fontColor=#8E2B20;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="760" y="340" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="redisDetalle" value="mesh:carrito:&lt;usuario&gt;   HASH, TTL 24 h&#10;mesh:oferta:&lt;id&gt;         venta relampago&#10;mesh:oferta:&lt;id&gt;:reservas   ZSET&#10;mesh:checkout:&lt;usuario&gt;  candado, EX 30 NX&#10;&#10;inventario_limitado.lua, ejecucion atomica" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF7F6;strokeColor=#E8B4AE;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="760" y="455" width="280" height="90" as="geometry" />
        </mxCell>

        <mxCell id="neo4j" value="Neo4j 7687 bolt&#10;&#10;RELACIONES ENTRE CUENTAS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FB;strokeColor=#7B3FA0;fontColor=#5A2C77;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1100" y="340" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="neoDetalle" value="(:Usuario)-[:ESCRIBIO]-&gt;(:Resena)&#10;(:Resena)-[:CALIFICA_A]-&gt;(:Usuario)&#10;(:Resena)-[:SOBRE]-&gt;(:Producto)&#10;(:Usuario)-[:VIVE_EN]-&gt;(:Direccion)&#10;&#10;5 consultas de fraude, una de varios saltos" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBF7FD;strokeColor=#CDB0DC;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1100" y="455" width="280" height="90" as="geometry" />
        </mxCell>

        <mxCell id="capaEtl" value="MIGRACION POR LOTES (no es tiempo real: ver docs/PENDIENTE-OUTBOX.md)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9E9E9E;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#757575;" vertex="1" parent="1">
          <mxGeometry x="40" y="680" width="1500" height="150" as="geometry" />
        </mxCell>
        <mxCell id="etlMongo" value="etl/cargar.js&#10;PostgreSQL &#8594; MongoDB&#10;replaceOne con upsert. NO borra." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6DC;strokeColor=#C9A227;fontColor=#7A6112;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="240" y="720" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="etlGrafo" value="etl/cargar_grafo.sh&#10;PostgreSQL &#8594; Neo4j&#10;Relee las 90 resenas cada vez (14 s)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6DC;strokeColor=#C9A227;fontColor=#7A6112;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="900" y="720" width="260" height="80" as="geometry" />
        </mxCell>

        <mxCell id="capaHerr" value="HERRAMIENTAS DE INSPECCION (no son parte del sistema)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#BDBDBD;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#9E9E9E;" vertex="1" parent="1">
          <mxGeometry x="40" y="870" width="1500" height="90" as="geometry" />
        </mxCell>
        <mxCell id="herr" value="pgAdmin :5050          dbgate :3001          RedisInsight :5540          Neo4j Browser :7474" style="text;html=1;fontSize=12;fontColor=#9E9E9E;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="900" width="1460" height="40" as="geometry" />
        </mxCell>

        <mxCell id="eFrontBack" value="HTTP + cookie de sesion" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#2F3A8F;fontSize=10;fontColor=#2F3A8F;" edge="1" parent="1" source="frontend" target="backend">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="eBackPg" value="pedidos, pagos, ofertas,&#10;stock, resenas, usuarios" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#1F6FB2;fontSize=10;fontColor=#134B7C;exitX=0.25;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="backend" target="pg">
          <mxGeometry relative="1" as="geometry" />
