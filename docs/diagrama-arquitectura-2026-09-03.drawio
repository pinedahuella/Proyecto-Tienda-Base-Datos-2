        <mxCell id="eEtlMongo" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#C9A227;dashed=1;" edge="1" parent="1" source="etlMongo" target="mongoDetalle">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ePgEtlGrafo" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#C9A227;dashed=1;" edge="1" parent="1" source="pgDetalle" target="etlGrafo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eEtlNeo" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#C9A227;dashed=1;" edge="1" parent="1" source="etlGrafo" target="neoDetalle">
          <mxGeometry relative="1" as="geometry" />
