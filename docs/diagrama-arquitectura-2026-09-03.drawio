        <mxCell id="eBackNeo" value="panel de fraude&#10;(solo lectura)" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#7B3FA0;fontSize=10;fontColor=#5A2C77;exitX=0.95;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="backend" target="neo4j">
