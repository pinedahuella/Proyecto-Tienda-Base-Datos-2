        <mxCell id="pgDetalle" value="42 tablas. usuarios y direcciones,&#10;categorias, ofertas, precio_historial,&#10;pedidos, lineas, pagos, kardex, resenas.&#10;Transaccion de compra con FOR UPDATE.&#10;Migracion 014: oferta.es_inventario_limitado" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#8FBEDC;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
