<mxfile host="Mesh"><diagram name="Arquitectura" id="arq-mesh"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="txt-1" value="Mesh, arquitectura políglota con seis motores de persistencia" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1500" height="30" as="geometry"/></mxCell><mxCell id="txt-2" value="Estado al 25 de septiembre de 2026. Las flechas continuas son lo que hace el backend, las punteadas y numeradas son datos que viajan de un motor a otro, y su mecanismo está en la leyenda." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1700" height="24" as="geometry"/></mxCell><mxCell id="cliente" value="&lt;b&gt;Frontend&lt;/b&gt;&lt;br&gt;SvelteKit, puerto 5173" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E6E6F5;strokeColor=#3D3D99;fontSize=12;align=center;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="300" height="62" as="geometry"/></mxCell><mxCell id="workers" value="&lt;b&gt;Workers del backend&lt;/b&gt;&lt;br&gt;grafo 10 s, buscador 10 s, login a Elasticsearch 5 s, anillos y familia B 15 min, fraude retrospectivo 15 min, hallazgos F1 a F6 cada día, más vendidos y más vistos 10 min, también vieron y para ti 15 min, vencimientos de venta relámpago y descuento 1 min, reglas automáticas 60 s, reglas por fecha 15 min, registro de ofertas en Redis 10 min" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888888;fontSize=11;align=left;verticalAlign=top;spacing=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="440" y="80" width="1380" height="84" as="geometry"/></mxCell><mxCell id="backend" value="&lt;b&gt;Backend&lt;/b&gt;, NestJS con Fastify, puerto 3000. Escribe en cinco motores y lee de los seis" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E6E6F5;strokeColor=#3D3D99;fontSize=12;align=center;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="216" width="1890" height="56" as="geometry"/></mxCell><mxCell id="fl-3" value="HTTP con cookie de sesión" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;fontSize=11;fontColor=#444444;exitX=0.080;exitY=1.000;exitDx=0;exitDy=0;entryX=0.013;entryY=0.000;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cliente" target="backend"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="neo4j" value="&lt;b&gt;Neo4j 5&lt;/b&gt;&lt;br&gt;&lt;b&gt;RELACIONES ENTRE CUENTAS&lt;/b&gt;&lt;br&gt;&lt;br&gt;cuentas, reseñas, productos&lt;br&gt;y domicilios, 3 aristas por reseña&lt;br&gt;anillos cerrados de varios saltos&lt;br&gt;7 patrones de reseñas, familia B&lt;br&gt;cadena, favor devuelto, coordinados" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;align=center;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="250" height="250" as="geometry"/></mxCell><mxCell id="fl-4" value="lee el panel de fraude" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.8;fontSize=11;fontColor=#222222;exitX=0.066;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="backend" target="neo4j"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pg" value="&lt;b&gt;PostgreSQL 18&lt;/b&gt;&lt;br&gt;&lt;b&gt;FUENTE DE VERDAD&lt;/b&gt;&lt;br&gt;&lt;br&gt;76 tablas y 97 llaves foráneas&lt;br&gt;pedidos, pagos, ofertas, stock&lt;br&gt;reglas de descuento automáticas&lt;br&gt;y por fecha, hallazgos F1 a F6&lt;br&gt;vectores de productos con pgvector&lt;br&gt;reseñas y señales de fraude&lt;br&gt;cola evento_grafo" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;align=center;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="368" y="390" width="250" height="250" as="geometry"/></mxCell><mxCell id="fl-5" value="pedidos, pagos, ofertas, reglas, reseñas" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.8;fontSize=11;fontColor=#222222;exitX=0.240;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="backend" target="pg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mongo" value="&lt;b&gt;MongoDB&lt;/b&gt;&lt;br&gt;&lt;b&gt;CATÁLOGO Y LOG DE LOGIN&lt;/b&gt;&lt;br&gt;&lt;br&gt;productos 3105, productos_eventos&lt;br&gt;categorias, eventos_autenticacion&lt;br&gt;atributos que varían por categoría&lt;br&gt;historial por eventos" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=center;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="696" y="390" width="250" height="250" as="geometry"/></mxCell><mxCell id="fl-6" value="catálogo, historial, intentos de login" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.8;fontSize=11;fontColor=#222222;exitX=0.413;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="backend" target="mongo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="es" value="&lt;b&gt;Elasticsearch 8&lt;/b&gt;&lt;br&gt;&lt;b&gt;BÚSQUEDA DE TEXTO&lt;/b&gt;&lt;br&gt;&lt;br&gt;mesh_productos, 3105 documentos&lt;br&gt;mesh_eventos_autenticacion&lt;br&gt;búsqueda difusa que ignora tildes" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=center;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1024" y="390" width="250" height="250" as="geometry"/></mxCell><mxCell id="fl-7" value="busca productos y eventos" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.8;fontSize=11;fontColor=#222222;exitX=0.587;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="backend" target="es"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ch" value="&lt;b&gt;ClickHouse&lt;/b&gt;&lt;br&gt;&lt;b&gt;EVENTOS EN EL TIEMPO&lt;/b&gt;&lt;br&gt;&lt;br&gt;base columnar, mesh_eventos&lt;br&gt;vista, carrito, compra, devolución,&lt;br&gt;búsqueda y clic, más el resumen diario&lt;br&gt;tendencias, embudo y búsquedas&lt;br&gt;sin respuesta&lt;br&gt;recomendaciones, vistos, también&lt;br&gt;vieron y para ti" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;align=center;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1352" y="390" width="250" height="250" as="geometry"/></mxCell><mxCell id="fl-8" value="escribe eventos, lee rankings y recomendaciones" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.8;fontSize=11;fontColor=#222222;exitX=0.760;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="backend" target="ch"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="redis" value="&lt;b&gt;Redis 8&lt;/b&gt;&lt;br&gt;&lt;b&gt;TRANSITORIO Y ATÓMICO&lt;/b&gt;&lt;br&gt;&lt;br&gt;carrito con expiración por inactividad&lt;br&gt;inventario limitado con script Lua&lt;br&gt;candado de checkout&lt;br&gt;contadores de fraude del login&lt;br&gt;vencimiento de descuentos con TTL&lt;br&gt;tres usuarios de ACL por servicio&lt;br&gt;más vendidos y más vistos&lt;br&gt;recomendaciones ya calculadas" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;align=center;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1680" y="390" width="250" height="250" as="geometry"/></mxCell><mxCell id="fl-9" value="carrito, reservas, candado, descuentos" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.8;fontSize=11;fontColor=#222222;exitX=0.934;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="backend" target="redis"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fl-10" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8A5A00;strokeWidth=1.5;fontSize=11;fontColor=#8A5A00;dashed=1;exitX=1.000;exitY=0.300;exitDx=0;exitDy=0;entryX=0.000;entryY=0.300;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pg" target="mongo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fl-11" value="2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8A5A00;strokeWidth=1.5;fontSize=11;fontColor=#8A5A00;dashed=1;exitX=0.000;exitY=0.300;exitDx=0;exitDy=0;entryX=1.000;entryY=0.300;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pg" target="neo4j"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fl-12" value="3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8A5A00;strokeWidth=1.5;fontSize=11;fontColor=#8A5A00;dashed=1;exitX=1.000;exitY=0.720;exitDx=0;exitDy=0;entryX=0.000;entryY=0.720;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="neo4j" target="pg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fl-13" value="4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8A5A00;strokeWidth=1.5;fontSize=11;fontColor=#8A5A00;dashed=1;exitX=1.000;exitY=0.300;exitDx=0;exitDy=0;entryX=0.000;entryY=0.300;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mongo" target="es"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fl-14" value="5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8A5A00;strokeWidth=1.5;fontSize=11;fontColor=#8A5A00;dashed=1;exitX=0.560;exitY=1.000;exitDx=0;exitDy=0;entryX=0.560;entryY=1.000;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="es" target="pg"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1164" y="674"/><mxPoint x="508" y="674"/></Array></mxGeometry></mxCell><mxCell id="fl-15" value="6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8A5A00;strokeWidth=1.5;fontSize=11;fontColor=#8A5A00;dashed=1;exitX=0.320;exitY=1.000;exitDx=0;exitDy=0;entryX=0.320;entryY=1.000;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="redis" target="pg"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1760" y="702"/><mxPoint x="448" y="702"/></Array></mxGeometry></mxCell><mxCell id="fl-16" value="7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8A5A00;strokeWidth=1.5;fontSize=11;fontColor=#8A5A00;dashed=1;exitX=0.440;exitY=1.000;exitDx=0;exitDy=0;entryX=0.440;entryY=1.000;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pg" target="ch"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="478" y="730"/><mxPoint x="1462" y="730"/></Array></mxGeometry></mxCell><mxCell id="fl-17" value="8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8A5A00;strokeWidth=1.5;fontSize=11;fontColor=#8A5A00;dashed=1;exitX=1.000;exitY=0.300;exitDx=0;exitDy=0;entryX=0.000;entryY=0.300;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ch" target="redis"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fl-18" value="9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8A5A00;strokeWidth=1.5;fontSize=11;fontColor=#8A5A00;dashed=1;exitX=0.320;exitY=1.000;exitDx=0;exitDy=0;entryX=0.320;entryY=1.000;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ch" target="pg"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1432" y="758"/><mxPoint x="448" y="758"/></Array></mxGeometry></mxCell><mxCell id="fl-19" value="10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8A5A00;strokeWidth=1.5;fontSize=11;fontColor=#8A5A00;dashed=1;exitX=0.440;exitY=1.000;exitDx=0;exitDy=0;entryX=0.440;entryY=1.000;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="redis" target="pg"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1790" y="786"/><mxPoint x="478" y="786"/></Array></mxGeometry></mxCell><mxCell id="fl-20" value="11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8A5A00;strokeWidth=1.5;fontSize=11;fontColor=#8A5A00;dashed=1;exitX=0.000;exitY=0.720;exitDx=0;exitDy=0;entryX=1.000;entryY=0.720;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mongo" target="pg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="txt-21" value="Leyenda de las flechas punteadas" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="836" width="800" height="24" as="geometry"/></mxCell><mxCell id="txt-22" value="&lt;b&gt;1&lt;/b&gt;&amp;nbsp;&amp;nbsp;PostgreSQL a MongoDB, etl/cargar.js por lotes, conserva lo que el vendedor edita desde la aplicación, y la cola evento_producto, que un worker vacía recalculando precio, stock y nota del producto que cambió" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="866" width="1800" height="22" as="geometry"/></mxCell><mxCell id="txt-23" value="&lt;b&gt;2&lt;/b&gt;&amp;nbsp;&amp;nbsp;PostgreSQL a Neo4j, cada reseña tocada entra en la cola evento_grafo y un worker la vacía cada 10 segundos" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="888" width="1800" height="22" as="geometry"/></mxCell><mxCell id="txt-24" value="&lt;b&gt;3&lt;/b&gt;&amp;nbsp;&amp;nbsp;Neo4j a PostgreSQL, los detectores de anillos y de la familia B corren cada 15 minutos, B también al llegar una reseña, y guardan lo que encuentran en senal_fraude" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="910" width="1800" height="22" as="geometry"/></mxCell><mxCell id="txt-25" value="&lt;b&gt;4&lt;/b&gt;&amp;nbsp;&amp;nbsp;MongoDB a Elasticsearch, la marca pendiente_busqueda cada 10 segundos y los intentos de login cada 5" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="932" width="1800" height="22" as="geometry"/></mxCell><mxCell id="txt-26" value="&lt;b&gt;5&lt;/b&gt;&amp;nbsp;&amp;nbsp;Elasticsearch a PostgreSQL, el análisis retrospectivo cada 15 minutos deja señales en senal_fraude" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="954" width="1800" height="22" as="geometry"/></mxCell><mxCell id="txt-27" value="&lt;b&gt;6&lt;/b&gt;&amp;nbsp;&amp;nbsp;Redis a PostgreSQL, un contador de fallos de login que cruza su umbral deja o suma una señal en senal_fraude" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="976" width="1800" height="22" as="geometry"/></mxCell><mxCell id="txt-28" value="&lt;b&gt;7&lt;/b&gt;&amp;nbsp;&amp;nbsp;PostgreSQL a ClickHouse, etl/cargar_compras.sh copia compras y devoluciones en cada arranque" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="998" width="1800" height="22" as="geometry"/></mxCell><mxCell id="txt-29" value="&lt;b&gt;8&lt;/b&gt;&amp;nbsp;&amp;nbsp;ClickHouse a Redis, cada 10 minutos se recalculan más vendidos y más vistos, y cada 15 también vieron y para ti" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1020" width="1800" height="22" as="geometry"/></mxCell><mxCell id="txt-30" value="&lt;b&gt;9&lt;/b&gt;&amp;nbsp;&amp;nbsp;ClickHouse a PostgreSQL, cada 60 segundos el disparador cuenta las ventas recientes y aplica la regla automática, y una vez al día los hallazgos F1 a F6 van a senal_fraude" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1042" width="1800" height="22" as="geometry"/></mxCell><mxCell id="txt-31" value="&lt;b&gt;10&lt;/b&gt;&amp;nbsp;&amp;nbsp;Redis a PostgreSQL, cada minuto un descuento cuya clave de vencimiento ya no existe se quita de oferta" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1064" width="1800" height="22" as="geometry"/></mxCell><mxCell id="txt-32" value="&lt;b&gt;11&lt;/b&gt;&amp;nbsp;&amp;nbsp;MongoDB a PostgreSQL, etl/cargar_vectores.ps1 le pide a Ollama el vector de cada producto y lo guarda en producto_vector, y el nombre, estado y portada de cada variante se copian a variante_catalogo para comprar sin MongoDB" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1086" width="1800" height="22" as="geometry"/></mxCell><mxCell id="txt-33" value="Herramientas de inspección que no son parte del sistema, pgAdmin 5050, DbGate 3001, RedisInsight 5540, Kibana 5601, Neo4j Browser 7474 y ClickHouse play 8123." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="1122" width="1800" height="22" as="geometry"/></mxCell><mxCell id="txt-34" value="Todo corre en una sola máquina, en diez contenedores de un mismo Docker, más uno de un solo uso que prepara las vistas de Kibana. Cada motor guarda lo que le corresponde por la forma de la pregunta que va a recibir." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="1146" width="1800" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>