<mxfile host="Mesh"><diagram name="Arquitectura" id="arq-mesh"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="txt-1" value="Mesh, arquitectura políglota con seis motores de persistencia" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1500" height="30" as="geometry"/></mxCell><mxCell id="txt-2" value="Estado al 19 de septiembre de 2026. Las flechas continuas son lo que hace el backend, las punteadas y numeradas son datos que viajan de un motor a otro, y su mecanismo está en la leyenda." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1700" height="24" as="geometry"/></mxCell><mxCell id="cliente" value="&lt;b&gt;Frontend&lt;/b&gt;&lt;br&gt;SvelteKit, puerto 5173" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E6E6F5;strokeColor=#3D3D99;fontSize=12;align=center;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="300" height="62" as="geometry"/></mxCell><mxCell id="workers" value="&lt;b&gt;Workers del backend&lt;/b&gt;&lt;br&gt;grafo 10 s, buscador 10 s, login a Elasticsearch 5 s, anillos 15 min, fraude retrospectivo 15 min, más vendidos 10 min, venta relámpago 1 min" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888888;fontSize=11;align=left;verticalAlign=top;spacing=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="440" y="86" width="1380" height="70" as="geometry"/></mxCell><mxCell id="backend" value="&lt;b&gt;Backend&lt;/b&gt;, NestJS con Fastify, puerto 3000. Escribe en cinco motores y lee de los seis" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E6E6F5;strokeColor=#3D3D99;fontSize=12;align=center;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="216" width="1890" height="56" as="geometry"/></mxCell><mxCell id="fl-3" value="HTTP con cookie de sesión" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;fontSize=11;fontColor=#444444;exitX=0.080;exitY=1.000;exitDx=0;exitDy=0;entryX=0.013;entryY=0.000;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cliente" target="backend"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="neo4j" value="&lt;b&gt;Neo4j 5&lt;/b&gt;&lt;br&gt;&lt;b&gt;RELACIONES ENTRE CUENTAS&lt;/b&gt;&lt;br&gt;&lt;br&gt;13 usuarios, 51 productos,&lt;br&gt;90 reseñas y 9 domicilios&lt;br&gt;3 aristas por reseña&lt;br&gt;5 consultas de varios saltos" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;align=center;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="250" height="210" as="geometry"/></mxCell><mxCell id="fl-4" value="lee el panel de fraude" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.8;fontSize=11;fontColor=#222222;exitX=0.066;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="backend" target="neo4j"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pg" value="&lt;b&gt;PostgreSQL 18&lt;/b&gt;&lt;br&gt;&lt;b&gt;FUENTE DE VERDAD&lt;/b&gt;&lt;br&gt;&lt;br&gt;50 tablas y 66 llaves foráneas&lt;br&gt;pedidos, pagos, ofertas, stock&lt;br&gt;reseñas, alertas y anillos de fraude&lt;br&gt;cola evento_grafo" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;align=center;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="368" y="390" width="250" height="210" as="geometry"/></mxCell><mxCell id="fl-5" value="pedidos, pagos, ofertas, reseñas" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.8;fontSize=11;fontColor=#222222;exitX=0.240;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="backend" target="pg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mongo" value="&lt;b&gt;MongoDB&lt;/b&gt;&lt;br&gt;&lt;b&gt;CATÁLOGO Y LOG DE LOGIN&lt;/b&gt;&lt;br&gt;&lt;br&gt;productos 1105, productos_eventos&lt;br&gt;categorias, eventos_autenticacion&lt;br&gt;atributos que varían por categoría&lt;br&gt;historial por eventos" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=center;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="696" y="390" width="250" height="210" as="geometry"/></mxCell><mxCell id="fl-6" value="catálogo, historial, intentos de login" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.8;fontSize=11;fontColor=#222222;exitX=0.413;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="backend" target="mongo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="es" value="&lt;b&gt;Elasticsearch 8&lt;/b&gt;&lt;br&gt;&lt;b&gt;BÚSQUEDA DE TEXTO&lt;/b&gt;&lt;br&gt;&lt;br&gt;mesh_productos, 1105 documentos&lt;br&gt;mesh_eventos_autenticacion&lt;br&gt;búsqueda difusa que ignora tildes" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=center;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1024" y="390" width="250" height="210" as="geometry"/></mxCell><mxCell id="fl-7" value="busca productos y eventos" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.8;fontSize=11;fontColor=#222222;exitX=0.587;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="backend" target="es"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ch" value="&lt;b&gt;ClickHouse&lt;/b&gt;&lt;br&gt;&lt;b&gt;EVENTOS EN EL TIEMPO&lt;/b&gt;&lt;br&gt;&lt;br&gt;base columnar, mesh_eventos&lt;br&gt;vista, carrito, compra, devolución,&lt;br&gt;búsqueda y clic, más el resumen diario&lt;br&gt;los rankings de tendencias salen de aquí" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;align=center;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1352" y="390" width="250" height="210" as="geometry"/></mxCell><mxCell id="fl-8" value="escribe eventos, lee rankings" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.8;fontSize=11;fontColor=#222222;exitX=0.760;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="backend" target="ch"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="redis" value="&lt;b&gt;Redis 8&lt;/b&gt;&lt;br&gt;&lt;b&gt;TRANSITORIO Y ATÓMICO&lt;/b&gt;&lt;br&gt;&lt;br&gt;carrito con expiración por inactividad&lt;br&gt;inventario limitado con script Lua&lt;br&gt;candado de checkout&lt;br&gt;contadores de fraude del login&lt;br&gt;ranking de más vendidos" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;align=center;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1680" y="390" width="250" height="210" as="geometry"/></mxCell><mxCell id="fl-9" value="carrito, reservas, candado" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.8;fontSize=11;fontColor=#222222;exitX=0.934;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="backend" target="redis"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fl-10" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8A5A00;strokeWidth=1.5;fontSize=11;fontColor=#8A5A00;dashed=1;exitX=1.000;exitY=0.300;exitDx=0;exitDy=0;entryX=0.000;entryY=0.300;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pg" target="mongo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fl-11" value="2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8A5A00;strokeWidth=1.5;fontSize=11;fontColor=#8A5A00;dashed=1;exitX=0.000;exitY=0.300;exitDx=0;exitDy=0;entryX=1.000;entryY=0.300;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pg" target="neo4j"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fl-12" value="3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8A5A00;strokeWidth=1.5;fontSize=11;fontColor=#8A5A00;dashed=1;exitX=1.000;exitY=0.720;exitDx=0;exitDy=0;entryX=0.000;entryY=0.720;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="neo4j" target="pg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fl-13" value="4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8A5A00;strokeWidth=1.5;fontSize=11;fontColor=#8A5A00;dashed=1;exitX=1.000;exitY=0.300;exitDx=0;exitDy=0;entryX=0.000;entryY=0.300;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mongo" target="es"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fl-14" value="5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8A5A00;strokeWidth=1.5;fontSize=11;fontColor=#8A5A00;dashed=1;exitX=0.560;exitY=1.000;exitDx=0;exitDy=0;entryX=0.560;entryY=1.000;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="es" target="pg"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1164" y="634"/><mxPoint x="508" y="634"/></Array></mxGeometry></mxCell><mxCell id="fl-15" value="6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8A5A00;strokeWidth=1.5;fontSize=11;fontColor=#8A5A00;dashed=1;exitX=0.320;exitY=1.000;exitDx=0;exitDy=0;entryX=0.320;entryY=1.000;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="redis" target="pg"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1760" y="662"/><mxPoint x="448" y="662"/></Array></mxGeometry></mxCell><mxCell id="fl-16" value="7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8A5A00;strokeWidth=1.5;fontSize=11;fontColor=#8A5A00;dashed=1;exitX=0.440;exitY=1.000;exitDx=0;exitDy=0;entryX=0.440;entryY=1.000;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pg" target="ch"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="478" y="690"/><mxPoint x="1462" y="690"/></Array></mxGeometry></mxCell><mxCell id="fl-17" value="8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8A5A00;strokeWidth=1.5;fontSize=11;fontColor=#8A5A00;dashed=1;exitX=1.000;exitY=0.300;exitDx=0;exitDy=0;entryX=0.000;entryY=0.300;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ch" target="redis"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="txt-18" value="Leyenda de las flechas punteadas" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="800" height="24" as="geometry"/></mxCell><mxCell id="txt-19" value="&lt;b&gt;1&lt;/b&gt;&amp;nbsp;&amp;nbsp;PostgreSQL a MongoDB, etl/cargar.js por lotes, conserva lo que el vendedor edita desde la aplicación" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="1800" height="22" as="geometry"/></mxCell><mxCell id="txt-20" value="&lt;b&gt;2&lt;/b&gt;&amp;nbsp;&amp;nbsp;PostgreSQL a Neo4j, cada reseña tocada entra en la cola evento_grafo y un worker la vacía cada 10 segundos" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="792" width="1800" height="22" as="geometry"/></mxCell><mxCell id="txt-21" value="&lt;b&gt;3&lt;/b&gt;&amp;nbsp;&amp;nbsp;Neo4j a PostgreSQL, el detector de anillos corre cada 15 minutos y guarda lo que encuentra en anillo_fraude" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="814" width="1800" height="22" as="geometry"/></mxCell><mxCell id="txt-22" value="&lt;b&gt;4&lt;/b&gt;&amp;nbsp;&amp;nbsp;MongoDB a Elasticsearch, la marca pendiente_busqueda cada 10 segundos y los intentos de login cada 5" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="836" width="1800" height="22" as="geometry"/></mxCell><mxCell id="txt-23" value="&lt;b&gt;5&lt;/b&gt;&amp;nbsp;&amp;nbsp;Elasticsearch a PostgreSQL, el análisis retrospectivo cada 15 minutos deja alertas en alerta_fraude" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="858" width="1800" height="22" as="geometry"/></mxCell><mxCell id="txt-24" value="&lt;b&gt;6&lt;/b&gt;&amp;nbsp;&amp;nbsp;Redis a PostgreSQL, un contador de fallos de login que cruza su umbral deja una fila en alerta_fraude" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="1800" height="22" as="geometry"/></mxCell><mxCell id="txt-25" value="&lt;b&gt;7&lt;/b&gt;&amp;nbsp;&amp;nbsp;PostgreSQL a ClickHouse, etl/cargar_compras.sh copia compras y devoluciones en cada arranque" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="902" width="1800" height="22" as="geometry"/></mxCell><mxCell id="txt-26" value="&lt;b&gt;8&lt;/b&gt;&amp;nbsp;&amp;nbsp;ClickHouse a Redis, un worker cada 10 minutos recalcula el ranking de más vendidos" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="924" width="1800" height="22" as="geometry"/></mxCell><mxCell id="txt-27" value="Herramientas de inspección que no son parte del sistema, pgAdmin 5050, DbGate 3001, RedisInsight 5540, Neo4j Browser 7474 y ClickHouse play 8123." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="960" width="1800" height="22" as="geometry"/></mxCell><mxCell id="txt-28" value="Todo corre en una sola máquina, en nueve contenedores de un mismo Docker. Cada motor guarda lo que le corresponde por la forma de la pregunta que va a recibir." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="984" width="1800" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>