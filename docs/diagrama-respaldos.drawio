<mxfile host="Mesh"><diagram name="Arquitectura" id="arq-mesh"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="txt-1" value="Qué base cubre a cuál cuando una se cae" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=28;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="6" width="1300" height="40" as="geometry"/></mxCell><mxCell id="txt-2" value="Cada flecha va de la base que cubre a la base caída. Su número está explicado abajo." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=17;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="48" width="1300" height="30" as="geometry"/></mxCell><mxCell id="mongo" value="&lt;b&gt;MongoDB&lt;/b&gt;&lt;br&gt;&lt;br&gt;ficha completa del producto" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=19;align=center;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="300" height="130" as="geometry"/></mxCell><mxCell id="es" value="&lt;b&gt;Elasticsearch&lt;/b&gt;&lt;br&gt;&lt;br&gt;buscador y sus filtros" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=19;align=center;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1060" y="90" width="300" height="130" as="geometry"/></mxCell><mxCell id="neo4j" value="&lt;b&gt;Neo4j&lt;/b&gt;&lt;br&gt;&lt;br&gt;para ti y también compraron" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=19;align=center;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="370" width="300" height="130" as="geometry"/></mxCell><mxCell id="pg" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;br&gt;la verdad, pedidos, pagos, stock y carrito" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=19;align=center;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="560" y="370" width="300" height="130" as="geometry"/></mxCell><mxCell id="redis" value="&lt;b&gt;Redis&lt;/b&gt;&lt;br&gt;&lt;br&gt;rankings, ofertas destacadas y copia del carrito" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=19;align=center;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1060" y="370" width="300" height="130" as="geometry"/></mxCell><mxCell id="ch" value="&lt;b&gt;ClickHouse&lt;/b&gt;&lt;br&gt;&lt;br&gt;vistas, búsquedas y tendencias" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=19;align=center;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1060" y="650" width="300" height="130" as="geometry"/></mxCell><mxCell id="fl-3" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1F5F1F;strokeWidth=3;fontSize=22;fontStyle=1;fontColor=#1F5F1F;exitX=0.200;exitY=0.000;exitDx=0;exitDy=0;entryX=0.500;entryY=1.000;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pg" target="mongo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fl-4" value="2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1F5F1F;strokeWidth=3;fontSize=22;fontStyle=1;fontColor=#1F5F1F;exitX=0.800;exitY=0.000;exitDx=0;exitDy=0;entryX=0.500;entryY=1.000;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pg" target="es"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fl-5" value="3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1F5F1F;strokeWidth=3;fontSize=22;fontStyle=1;fontColor=#1F5F1F;exitX=0.000;exitY=0.500;exitDx=0;exitDy=0;entryX=1.000;entryY=0.500;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pg" target="neo4j"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fl-6" value="4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1F5F1F;strokeWidth=3;fontSize=22;fontStyle=1;fontColor=#1F5F1F;exitX=1.000;exitY=0.300;exitDx=0;exitDy=0;entryX=0.000;entryY=0.300;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pg" target="redis"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fl-7" value="5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1F5F1F;strokeWidth=3;fontSize=22;fontStyle=1;fontColor=#1F5F1F;exitX=0.000;exitY=0.750;exitDx=0;exitDy=0;entryX=1.000;entryY=0.750;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="redis" target="pg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fl-8" value="6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1F5F1F;strokeWidth=3;fontSize=22;fontStyle=1;fontColor=#1F5F1F;exitX=0.300;exitY=0.000;exitDx=0;exitDy=0;entryX=0.300;entryY=1.000;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ch" target="redis"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fl-9" value="7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1F5F1F;strokeWidth=3;fontSize=22;fontStyle=1;fontColor=#1F5F1F;exitX=0.700;exitY=1.000;exitDx=0;exitDy=0;entryX=0.700;entryY=0.000;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="redis" target="ch"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sin" value="&lt;b&gt;Sin respaldo, a propósito&lt;/b&gt;&lt;br&gt;Pagar e iniciar sesión sin PostgreSQL&lt;br&gt;Crear o cambiar productos sin MongoDB&lt;br&gt;Crear un avísame sin Elasticsearch&lt;br&gt;Viste hace poco y las tendencias sin ClickHouse" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;fontSize=17;align=left;verticalAlign=top;spacing=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="60" y="650" width="820" height="125" as="geometry"/></mxCell><mxCell id="txt-10" value="&lt;b&gt;1&lt;/b&gt; Sin MongoDB el catálogo y la ficha salen de la copia en PostgreSQL, sin las características&lt;br&gt;&lt;b&gt;2&lt;/b&gt; Sin Elasticsearch el buscador y sus filtros salen de la misma copia, con la misma regla de texto&lt;br&gt;&lt;b&gt;3&lt;/b&gt; Sin Neo4j para ti y también compraron salen de los pedidos en PostgreSQL&lt;br&gt;&lt;b&gt;4&lt;/b&gt; Sin Redis las ofertas destacadas y el carrito salen de PostgreSQL&lt;br&gt;&lt;b&gt;5&lt;/b&gt; Sin PostgreSQL la sesión abierta sigue por su token y el perfil y el carrito salen de la copia en Redis&lt;br&gt;&lt;b&gt;6&lt;/b&gt; Sin Redis los cuatro rankings se calculan en el momento en ClickHouse&lt;br&gt;&lt;b&gt;7&lt;/b&gt; Sin ClickHouse lo más vendido, lo más visto y se compran juntos siguen en Redis" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=17;" vertex="1" parent="1"><mxGeometry x="60" y="810" width="1300" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>